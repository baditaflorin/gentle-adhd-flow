{
  "name": "gentle-adhd-flow",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first ADHD self-management: voice brain-dumps become tasks, focus sessions, habits, and gentle planning.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/write-build-meta.mjs",
    "build": "tsc -b && node scripts/clean-build-assets.mjs && vite build && node scripts/copy-piper-assets.mjs && node scripts/copy-404.mjs && node scripts/check-budget.mjs",
    "lint": "eslint .",
    "preview": "node scripts/pages-preview.mjs",
    "pages-preview": "node scripts/pages-preview.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:integration": "vitest run src",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke.sh",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.9",
    "lucide-react": "^1.14.0",
    "piper-tts-web": "^1.1.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tone": "^15.1.22",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  }
}
